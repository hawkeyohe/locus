LOCUS_DATABASE_PATH=locus.db
# Generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
LOCUS_ENCRYPTION_KEY=replace-with-a-generated-fernet-key
LOCUS_APP_URL=http://127.0.0.1:8000
LOCUS_PORT=8000
LOCUS_DEFAULT_TIMEOUT_MS=10000
LOCUS_MAX_RESPONSE_BYTES=1048576
LOCUS_MAX_REQUEST_BYTES=262144
LOCUS_ALLOW_LOCAL_ENDPOINTS=false
LOCUS_DEMO_SEED=true
LOCUS_WORKER_CONCURRENCY=2
LOCUS_MAX_TESTS_PER_RUN=100
LOCUS_MAX_REDIRECTS=0
# Reserved for a future optional model-based evaluator; deterministic evaluators do not use it.
LOCUS_LLM_EVALUATOR_ENABLED=false
LOCUS_LLM_API_KEY=
